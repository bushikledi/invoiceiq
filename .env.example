# Copy to .env and adjust. Every value below is validated at boot by
# packages/config — a missing or malformed entry crashes the process
# immediately with an aggregated error, never silently at request time.

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------- datastores
# Standard ports. If another local stack already owns these, change them here
# and in DATABASE_URL / REDIS_URL / S3_ENDPOINT below; docker-compose reads them.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgresql://invoiceiq:invoiceiq@localhost:5432/invoiceiq?schema=public
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- object store
# Local MinIO. In production these become real S3 values and
# S3_FORCE_PATH_STYLE flips to false.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-south-1
S3_BUCKET=invoiceiq-documents
S3_ACCESS_KEY_ID=invoiceiq
S3_SECRET_ACCESS_KEY=invoiceiq-dev-secret
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------- api
PORT=3001
# openssl rand -hex 32
JWT_SECRET=dev-only-secret-replace-me-with-32-bytes-of-real-entropy
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000
PRESIGNED_GET_TTL_SECONDS=300
PRESIGNED_PUT_TTL_SECONDS=300

# Pre-filled on the login screen so the demo is fast.
DEMO_EMAIL=demo@invoiceiq.dev
DEMO_PASSWORD=demo-password-123

# ---------------------------------------------------------------- llm
# `fixture` replays recorded responses from packages/ai/src/fixtures: the whole
# pipeline runs with zero network and zero spend. Set ANTHROPIC_API_KEY and
# flip to `anthropic` to go live.
LLM_PROVIDER=fixture
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MODEL_FALLBACK=claude-sonnet-5
MAX_EXTRACTION_ATTEMPTS=3
MAX_PROMPT_TOKENS=8000

# ---------------------------------------------------------------- embeddings
# `local` runs multilingual MiniLM in-process: no API key, 384 dimensions, and
# it handles the Italian sample invoices. Switching to `openai` means
# text-embedding-3-small at 1536 dims — EMBEDDING_DIM must match the pgvector
# column, so changing it requires a migration.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------- pipeline
CONFIDENCE_THRESHOLD=0.85
EXTRACTION_CONCURRENCY=2
EMBEDDING_CONCURRENCY=5
EXTRACTION_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------- web
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

# Pre-filled on the login form so the demo does not open with someone typing a
# password. Safe ONLY because the demo account is seeded and disposable —
# NEXT_PUBLIC_* values are compiled into the client bundle.
NEXT_PUBLIC_DEMO_EMAIL=demo@invoiceiq.dev
NEXT_PUBLIC_DEMO_PASSWORD=demo-password-123
