{
  "name": "@invoiceiq/worker",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS standalone application: consumes extraction and embedding jobs. No HTTP server.",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "start:local": "dotenv -e ../../.env -- node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@invoiceiq/ai": "workspace:*",
    "@invoiceiq/config": "workspace:*",
    "@invoiceiq/database": "workspace:*",
    "@invoiceiq/domain": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "bullmq": "^5.81.2",
    "ioredis": "^5.9.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@testcontainers/postgresql": "^11",
    "@testcontainers/redis": "^11",
    "@types/node": "^24.13.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^11",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
