{
  "name": "invoiceiq",
  "version": "0.1.0",
  "private": true,
  "description": "AI document extraction pipeline: PDF invoice -> LLM structured extraction -> validation -> human review -> semantic search",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm infra:up && pnpm infra:wait && pnpm db:deploy && pnpm db:seed",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres redis minio && docker compose -f infra/docker-compose.yml up minio-setup",
    "infra:wait": "docker compose -f infra/docker-compose.yml up -d --wait postgres redis minio",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:nuke": "docker compose -f infra/docker-compose.yml down -v",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "boundaries:verify": "bash scripts/verify-boundaries.sh",
    "boundaries:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps packages | dot -T svg > docs/architecture-graph.svg",
    "test:unit": "turbo run test:unit",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:deploy": "pnpm --filter @invoiceiq/database db:migrate:deploy",
    "db:migrate": "pnpm --filter @invoiceiq/database db:migrate",
    "db:reset": "pnpm --filter @invoiceiq/database db:reset",
    "db:seed": "pnpm --filter @invoiceiq/database db:seed",
    "db:studio": "pnpm --filter @invoiceiq/database db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\"",
    "seed:demo": "dotenv -e .env -- tsx scripts/seed-demo.ts",
    "dev:stack": "bash scripts/dev-stack.sh"
  },
  "devDependencies": {
    "@invoiceiq/config": "workspace:*",
    "dependency-cruiser": "^18.1.0",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.10.7",
    "typescript": "^5.7.3"
  }
}
