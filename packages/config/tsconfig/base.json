{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "InvoiceIQ base",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    // A build that does not typecheck must not produce output. Without this,
    // tsc emits JS alongside the errors and a broken artifact can reach a
    // container image.
    "noEmitOnError": true
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}
