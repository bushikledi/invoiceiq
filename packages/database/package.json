{
  "name": "@invoiceiq/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, repositories and seed data. The only package that knows SQL.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@invoiceiq/domain": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.2",
    "prisma": "6.19.2"
  },
  "devDependencies": {
    "@invoiceiq/config": "workspace:*",
    "@types/node": "^24.13.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
