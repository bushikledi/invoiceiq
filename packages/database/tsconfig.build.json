{
  "extends": "@invoiceiq/config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    // The generated Prisma client is third-party code we do not control.
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "prisma/seed.ts", "generated/**"]
}
