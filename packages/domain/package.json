{
  "name": "@invoiceiq/domain",
  "version": "0.1.0",
  "private": true,
  "description": "The pure domain core: entities, value objects, business rules, policies. Zero framework imports.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@invoiceiq/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
