{
  "name": "@invoiceiq/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Prometheus metric definitions shared by the API and the worker",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@invoiceiq/config": "workspace:*",
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.1.10"
  }
}
